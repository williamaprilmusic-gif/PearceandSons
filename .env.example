# Copy to .env (gitignored) and fill in real values. Placeholders only here.
#
# The Supabase project URL and the publishable (anon) client key are NOT in
# this file — they are embedded directly in src/TransitOS_web.jsx because the
# publishable key is a client-side, RLS-gated key that is safe to ship in the
# bundle. Everything below is either a client build-time var (VITE_*) or a
# server-side secret used only by the Supabase edge functions.

# ── Client (bundled into the web build by Vite; VITE_-prefixed only) ──
# TomTom key for in-app nav + route optimization. If absent, the app silently
# falls back to Nominatim — it is optional.
VITE_TOMTOM_API_KEY=your-tomtom-api-key
# Sentry DSN for client error reporting. If absent, error reporting is off.
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Server-side (Supabase edge function secrets — never VITE_-prefixed) ──
# Transactional email (Resend). NOTE: the functions read RESEND_API_KEY first
# and fall back to the legacy mixed-case Resend_API_Key — set ONE of them.
RESEND_API_KEY=re_your_resend_api_key
# Gemini API key for the AI ops assistant.
GEMINI_API_KEY=your-gemini-api-key
# Shared secret the pg_cron scheduler sends as a Bearer token to authenticate
# scheduled edge-function calls.
CRON_AUTH_TOKEN=generate-a-long-random-token
# Comma-separated JWT signing secrets used to verify project tokens.
PROJECT_JWT_SECRETS=secret-1,secret-2
# Supabase service-role key (full DB access) — used only by edge functions.
# Auto-injected in the deployed edge runtime; set locally to run functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase project URL — auto-injected in the deployed edge runtime; set
# locally to run functions.
SUPABASE_URL=https://your-project-ref.supabase.co

# ── Web push (VAPID) — used by the push-related edge functions ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=mailto:you@example.com
